NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigma_talenta
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative single connection string (used in production via Dokploy)
DATABASE_URL=
# Set to true when the database requires SSL (managed Postgres)
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=15m

# Seeding (entry.sh runs `db:seed:all` when SEED_DB=true)
# ADMIN_PASSWORD is mandatory when seeding in production.
SEED_DB=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of allowed origins
CORS_ORIGINS=https://sigma-talenta.com,https://professional.sigma-talenta.com,https://manpower.sigma-talenta.com,https://hospitality.sigma-talenta.com

# S3-compatible object storage (Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_URL=
